<%- include("layout", { title: title, body: `
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h1 class="h3 mb-1">Reportes</h1>
      <div class="text-muted">Top vendedores por utilidad</div>
    </div>

    <div class="d-flex gap-2">
      <select class="form-select" id="limitSelect" style="width: 140px;">
        <option value="5">Top 5</option>
        <option value="10" selected>Top 10</option>
        <option value="20">Top 20</option>
      </select>
      <button class="btn btn-outline-secondary" id="btnRefrescar">Refrescar</button>
    </div>
  </div>

  <div id="alertBox"></div>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="fw-semibold mb-2">Ranking (tabla)</div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Vendedor</th>
                  <th class="text-end">Ventas</th>
                  <th class="text-end">Total venta</th>
                  <th class="text-end">Utilidad</th>
                </tr>
              </thead>
              <tbody id="tbodyReportes">
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">Cargando...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="small text-muted mt-2">
            Fuente: <code>/api/reportes/top-vendedores</code>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="fw-semibold mb-2">Utilidad por vendedor (gráfico)</div>
          <canvas id="chartUtilidad" height="140"></canvas>
          <div class="small text-muted mt-2">
            * Chart.js (solo visual, datos vienen del backend)
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <script>
    window.API_BASE_URL = "${apiBaseUrl}";
  </script>
  <script src="/js/reportes.js"></script>
`}) %>
