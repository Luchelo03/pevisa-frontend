<%- include("layout", { title: title, body: `
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h1 class="h3 mb-1">Clientes</h1>
      <div class="text-muted">CRUD conectado al backend Flask</div>
    </div>
    <button class="btn btn-primary" id="btnNuevo">+ Nuevo</button>
  </div>

  <div id="alertBox"></div>

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>DNI/RUC</th>
              <th>Nombre / Razón social</th>
              <th>Teléfono</th>
              <th>Email</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody id="tbodyClientes">
            <tr>
              <td colspan="6" class="text-center text-muted py-4">Cargando...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Crear/Editar -->
  <div class="modal fade" id="clienteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Cliente</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <form id="clienteForm">
            <div class="mb-3">
              <label class="form-label">DNI/RUC</label>
              <input class="form-control" id="dni_ruc" placeholder="DNI (8) o RUC (11)" required />
            </div>

            <div class="mb-3">
              <label class="form-label">Nombre / Razón social</label>
              <input class="form-control" id="nombre_razon_social" required />
            </div>

            <div class="mb-3">
              <label class="form-label">Teléfono</label>
              <input class="form-control" id="telefono" />
            </div>

            <div class="mb-0">
              <label class="form-label">Email</label>
              <input class="form-control" id="email" type="email" />
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary" id="btnGuardar">Guardar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    window.API_BASE_URL = "${apiBaseUrl}";
  </script>
  <script src="/js/clientes.js"></script>
`}) %>
